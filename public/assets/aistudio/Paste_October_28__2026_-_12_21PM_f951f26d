```typescript
interface Snapshot {
  id: string;
  taskId: string;
  timestamp: string;
  files: Map<string, { content: string; hash: string }>;
}

class RollbackManager {
  private snapshots: Map<string, Snapshot> = new Map();
  private workspace: WorkspaceProvider;
  
  constructor(workspace: WorkspaceProvider) {
    this.workspace = workspace;
  }
  
  async createSnapshot(taskId: string): Promise<string> {
    const snapshotId = `snap-${Date.now()}-${Math.random().toString(36).substring(7)}`;
    const files = new Map<string, { content: string; hash: string }>();
    
    // Get all files in workspace
    const tree = await this.workspace.getFileTree();
    const filePaths = this.getAllFilePaths(tree);
    
    // Read each file
    for (const filePath of filePaths) {
      try {
        const content = await this.workspace.readFile(filePath);
        const hash = this.hashContent(content.content);
        files.set(filePath, { content: content.content, hash });
      } catch (err) {
        // Skip unreadable files
      }
    }
    
    const snapshot: Snapshot = {
      id: snapshotId,
      taskId,
      timestamp: new Date().toISOString(),
      files
    };
    
    this.snapshots.set(snapshotId, snapshot);
    
    return snapshotId;
  }
  
  async restoreSnapshot(snapshotId: string): Promise<void> {
    const snapshot = this.snapshots.get(snapshotId);
    if (!snapshot) {
      throw new Error('Snapshot not found');
    }
    
    // Restore each file
    for (const [filePath, fileData] of snapshot.files.entries()) {
      await this.workspace.writeFile(filePath, fileData.content);
    }
  }
  
  async applyPatchWithRollback(
    filePath: string,
    searchBlock: string,
    replaceBlock: string,
    taskId: string
  ): Promise<void> {
    // Create snapshot before patch
    const snapshotId = await this.createSnapshot(taskId);
    
    try {
      // Read original content
      const clip = await this.workspace.readFile(filePath);
      const originalContent = clip.content;
      
      // Apply patch
      const result = applySearchReplace(originalContent, searchBlock, replaceBlock);
      
      if (!result.success) {
        throw new Error(result.error);
      }
      
      // Write patched content
      await this.workspace.writeFile(filePath, result.result);
      
    } catch (error) {
      // Rollback on failure
      console.error('Patch failed, rolling back...', error);
      await this.restoreSnapshot(snapshotId);
      throw error;
    }
  }
  
  private getAllFilePaths(node: FileNode): string[] {
    const paths: string[] = [];
    
    if (!node.isDirectory) {
      paths.push(node.path);
      return paths;
    }
    
    if (node.children) {
      for (const child of node.children) {
        paths.push(...this.getAllFilePaths(child));
      }
    }
    
    return paths;
  }
  
  private hashContent(content: string): string {
    // Simple hash function
    let hash = 0;
    for (let i = 0; i < content.length; i++) {
      const char = content.charCodeAt(i);
      hash = ((hash << 5) - hash) + char;
      hash = hash & hash; // Convert to 32bit integer
    }
    return hash.toString(16);
  }
  
  // Cleanup old snapshots
  cleanupOldSnapshots(maxAge: number = 3600000): void {
    const now = Date.now();
    
    for (const [id, snapshot] of this.snapshots.entries()) {
      const age = now - new Date(snapshot.timestamp).getTime();
      if (age > maxAge) {
        this.snapshots.delete(id);
      }
    }
  }
}
