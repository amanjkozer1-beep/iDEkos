class ContextManager {
  private maxTokens: number;
  private reservedTokens: number;
  
  constructor(maxTokens: number = 128000, reservedTokens: number = 1000) {
    this.maxTokens = maxTokens;
    this.reservedTokens = reservedTokens;
  }
  
  truncateHistory(history: any[], currentPrompt: string): any[] {
    const historyTokens = this.countTokens(history);
    const promptTokens = this.countTokens(currentPrompt);
    const totalTokens = historyTokens + promptTokens;
    
    if (totalTokens <= this.maxTokens - this.reservedTokens) {
      return history;
    }
    
    // Remove oldest messages
    const truncated = [...history];
    while (this.countTokens(truncated) + promptTokens > this.maxTokens - this.reservedTokens) {
      truncated.shift();
    }
    
    return truncated;
  }
  
  countTokens(text: string): number {
    // Use tiktoken or estimation
    return Math.ceil(text.length / 4); // Rough estimate
  }
  
  countHistory(history: any[]): number {
    return history.reduce((total, msg) => {
      const text = this.extractText(msg);
      return total + this.countTokens(text);
    }, 0);
  }
  
  private extractText(msg: any): string {
    if (typeof msg === 'string') return msg;
    if (msg.text) return msg.text;
    if (msg.parts) {
      return msg.parts.map((p: any) => p.text || '').join('');
    }
    return '';
  }
}
