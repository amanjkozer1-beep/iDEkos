class ContextManager {
  private maxTokens: number = 128000; // For gemini-1.5-pro
  private reservedTokens: number = 1000; // For system prompt
  
  truncateToTokenLimit(history: any[], currentPrompt: string): any[] {
    const totalTokens = this.countHistoryTokens(history) + this.countTokens(currentPrompt);
    
    if (totalTokens <= this.maxTokens - this.reservedTokens) {
      return history;
    }
    
    // Remove oldest messages until within limit
    const truncated = [...history];
    while (this.countHistoryTokens(truncated) + this.countTokens(currentPrompt) > this.maxTokens - this.reservedTokens) {
      truncated.shift();
    }
    
    return truncated;
  }
  
  private countHistoryTokens(history: any[]): number {
    return history.reduce((total, msg) => {
      const text = this.extractTextFromMessage(msg);
      return total + this.countTokens(text);
    }, 0);
  }
  
