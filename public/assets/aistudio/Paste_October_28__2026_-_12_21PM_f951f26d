#### 2. HardenedShellAdapter

**المسار**: `src/server/adapters/HardenedShellAdapter.ts`

**التنفيذ الحالي**:
```typescript
export class HardenedShellAdapter implements ShellProvider {
  private rootPath: string;
  private runningProcesses: Map<number, ChildProcess> = new Map();
  private maxOutputBytes = 1024 * 1024; // 1MB cap
  
  // القائمة البيضاء للأوامر المسموحة
  private static readonly ALLOWED_BINARIES = new Set([
    'npm', 'node', 'npx', 'git', 'ls', 'cat', 'pwd', 'echo',
    'grep', 'find', 'head', 'tail', 'wc', 'tsc', 'mkdir',
    'touch', 'cp', 'mv', 'stat', 'which', 'uname', 'date',
    'diff', 'tsx', 'tree', 'true', 'false'
  ]);
  
  // المتغيرات المحظورة
  private static readonly INTERPRETERS = new Set([
    'node', 'npx', 'npm', 'tsx', 'python', 'python3'
  ]);
  
  // تحليل arguments
  public parseArgv(rawCommand: string): string[] {
    const tokens: string[] = [];
    let current = '';
    let inQuote: '"' | "'" | null = null;
    
    for (let i = 0; i < rawCommand.length; i++) {
      const char = rawCommand[i];
      
      if (inQuote) {
        if (char === inQuote) {
          inQuote = null;
        } else {
          current += char;
        }
      } else if (char === '"' || char === "'") {
        inQuote = char;
      } else if (/\s/.test(char)) {
        if (current.length > 0) {
          tokens.push(current);
          current = '';
        }
      } else {
        current += char;
      }
    }
    
    if (current.length > 0) {
      tokens.push(current);
    }
    
    return tokens;
  }
  
  // التحقق من أمان الأمر
  public validateCommand(rawCommand: string): ValidationResult {
    const trimmed = rawCommand.trim();
    if (!trimmed) {
      return { isAllowed: false, reason: 'Command is empty.' };
    }
    
    // 1. حظر metacharacters
    const forbiddenMeta = [';', '|', '&', '>', '<', '`', '\n', '\r'];
    for (const char of forbiddenMeta) {
      if (trimmed.includes(char)) {
        return {
          isAllowed: false,
          reason: `Security rejection: Shell metacharacter '${char}' is prohibited.`
        };
      }
    }
    
    // 2. حظر command substitution
    if (/\$\(.*\)/.test(trimmed)) {
      return {
        isAllowed: false,
        reason: 'Security rejection: Command substitution $(...) is prohibited.'
      };
    }
    
    const argv = this.parseArgv(trimmed);
    if (argv.length === 0) {
      return { isAllowed: false, reason: 'Empty command argv.' };
    }
    
    const binary = path.basename(argv[0]).toLowerCase();
    
    // 3. حظر العمليات التدميرية
    if (binary === 'rm' || argv.includes('-rf') || argv.includes('-fr')) {
      return {
        isAllowed: false,
        reason: 'Command blocked: Recursive deletion is prohibited.'
      };
    }
    
    // 4. التحقق من القائمة البيضاء
    if (!HardenedShellAdapter.ALLOWED_BINARIES.has(binary)) {
      return {
        isAllowed: false,
        binary,
        reason: `Command binary "${binary}" is not in the authorized sandbox allowlist.`
      };
    }
    
    // 5. التحقق من المسارات
    for (let i = 1; i < argv.length; i++) {
      const arg = argv[i];
      if (arg.includes('/') || arg.startsWith('.')) {
        if (arg.startsWith('/etc') || arg.startsWith('/root') || arg.startsWith('/var')) {
          return {
            isAllowed: false,
            binary,
            reason: `Path access to system directory "${arg}" is prohibited.`
          };
        }
        
        const resolved = path.resolve(this.rootPath, arg);
        if (!resolved.startsWith(this.rootPath)) {
          return {
            isAllowed: false,
            binary,
            reason: `Path argument "${arg}" resolves outside workspace root.`
          };
        }
      }
    }
    
    const isInterpreter = HardenedShellAdapter.INTERPRETERS.has(binary);
    
    return {
      isAllowed: true,
      binary,
      argv,
      requiresApproval: isInterpreter
    };
  }
  
  // تنفيذ الأمر
  public async executeCommand(rawCommand: string, options: { timeoutMs?: number } = {}): Promise<CommandResult> {
    const check = this.validateCommand(rawCommand);
    if (!check.isAllowed || !check.argv) {
      return {
        stdout: '',
        stderr: `[K.O.S Sandbox Security]: ${check.reason}`,
        exitCode: 126,
        blocked: true,
        reason: check.reason
      };
    }
    
    const [binary, ...args] = check.argv;
    
    // بيئة معزولة
    const scrubbedEnv: NodeJS.ProcessEnv = {
      PATH: process.env.PATH || '/usr/local/bin:/usr/bin:/bin',
      HOME: this.rootPath,
      PWD: this.rootPath,
      USER: 'kos',
      LANG: 'en_US.UTF-8',
      TERM: 'xterm-256color'
    };
    
    // ... spawn child process with timeout and output caps
  }
}
```

**النقاط القوية**:
- ✅ قائمة بيضاء صارمة (38 binary فقط)
- ✅ حظر metacharacters
- ✅ حظر command substitution
- ✅ حعم path traversal
- ✅ Environment scrubbing
- ✅ Timeout (60s)
- ✅ Output cap (1MB)
- ✅ NO shell execution

**النقاط الضعيفة**:
- ❌ Environment scrubbing غير كامل (PATH قد يحتوي على info)
- ❌ لا يوجد Rate limiting
- ❌ لا يوجد Resource limits (CPU, Memory)
- ❌ لا يوجد Audit logging
- ❌ لا يوجد Process isolation (containers)

**التحسينات المطلوبة**:
```typescript
// 1. Environment Whitelist
private static readonly ALLOWED_ENV_VARS = new Set([
  'PATH', 'HOME', 'PWD', 'USER', 'LANG', 'TERM', 'NODE_ENV'
]);

private scrubEnvironment(originalEnv: NodeJS.ProcessEnv): NodeJS.ProcessEnv {
  const scrubbed: NodeJS.ProcessEnv = {};
  
  for (const key of HardenedShellAdapter.ALLOWED_ENV_VARS) {
    if (key === 'PATH') {
      // Restrict PATH to safe directories only
      scrubbed[key] = '/usr/local/bin:/usr/bin:/bin';
    } else {
      scrubbed[key] = originalEnv[key] || this.getDefaultEnv(key);
    }
  }
  
  return scrubbed;
}

// 2. Resource Limits
private static readonly RESOURCE_LIMITS = {
  maxCpu: 0.5, // 50% CPU
  maxMemory: 512 * 1024 * 1024, // 512MB
  maxOpenFiles: 100
};

public async executeCommand(rawCommand: string, options: { timeoutMs?: number } = {}): Promise<CommandResult> {
  // ... validation
  
  const child = spawn(binary, args, {
    cwd: this.rootPath,
    env: this.scrubEnvironment(process.env),
    shell: false,
    stdio: ['ignore', 'pipe', 'pipe'],
    // Resource limits (Unix only)
    ulimit: {
      rtprio: 50, // Lower priority
      as: HardenedShellAdapter.RESOURCE_LIMITS.maxMemory,
      nofile: HardenedShellAdapter.RESOURCE_LIMITS.maxOpenFiles
    }
  });
  
  // ... rest of implementation
}

// 3. Audit Logging
private auditLog: Array<{ timestamp: string; command: string; user: string; exitCode: number }> = [];

private logExecution(command: string, exitCode: number): void {
  this.auditLog.push({
    timestamp: new Date().toISOString(),
    command,
    user: process.env.USER || 'unknown',
    exitCode
  });
  
  // Write to persistent log file
  fs.appendFileSync(
    path.join(this.rootPath, '.kos-audit.log'),
    JSON.stringify(this.auditLog[this.auditLog.length - 1]) + '\n'
  );
}

// 4. Rate Limiting
private commandRateLimiter = new Map<string, { count: number; resetTime: number }>();
private static readonly RATE_LIMIT = {
  maxCommands: 10,
  windowMs: 60000 // 1 minute
};

private checkRateLimit(user: string): boolean {
  const now = Date.now();
  const userLimit = this.commandRateLimiter.get(user);
  
  if (!userLimit || now > userLimit.resetTime) {
    this.commandRateLimiter.set(user, {
      count: 1,
      resetTime: now + HardenedShellAdapter.RATE_LIMIT.windowMs
    });
    return true;
  }
  
  if (userLimit.count >= HardenedShellAdapter.RATE_LIMIT.maxCommands) {
    return false; // Rate limited
  }
  
  userLimit.count++;
  return true;
}
```

