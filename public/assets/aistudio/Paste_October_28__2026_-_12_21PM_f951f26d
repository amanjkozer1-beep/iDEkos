// 4. Response Caching
class ResponseCache {
  private cache: Map<string, { response: ModelCallResult; timestamp: number }> = new Map();
  private ttl: number = 300000; // 5 minutes
  
  get(key: string): ModelCallResult | null {
    const cached = this.cache.get(key);
    if (!cached) return null;
    
    if (Date.now() - cached.timestamp > this.ttl) {
      this.cache.delete(key);
      return null;
    }
    
    return cached.response;
  }
  
  set(key: string, response: ModelCallResult): void {
    this.cache.set(key, { response, timestamp: Date.now() });
  }
  
  clear(): void {
    this.cache.clear();
  }
}

// 5. Cost Tracking
class CostTracker {
  private costs: Map<string, number> = new Map();
  
  recordCost(model: string, inputTokens: number, outputTokens: number): void {
    const cost = this.calculateCost(model, inputTokens, outputTokens);
    const current = this.costs.get(model) || 0;
    this.costs.set(model, current + cost);
  }
  
  getTotalCost(): number {
    return Array.from(this.costs.values()).reduce((sum, cost) => sum + cost, 0);
  }
  
  getCostByModel(): Map<string, number> {
    return new Map(this.costs);
  }
  
  private calculateCost(model: string, inputTokens: number, outputTokens: number): number {
    // Pricing per 1M tokens
    const pricing = {
      'gemini-1.5-pro': { input: 1.25, output: 5.0 },
      'gemini-1.5-flash': { input: 0.075, output: 0.30 },
      'gemini-3.5-flash-lite': { input: 0.01, output: 0.05 }
    };
    
    const modelPricing = pricing[model] || { input: 0.01, output: 0.05 };
    return (inputTokens / 1000000) * modelPricing.input + (outputTokens / 1000000) * modelPricing.output;
  }
}

