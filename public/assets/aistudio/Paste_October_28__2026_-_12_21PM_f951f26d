  const insertStmt = db.prepare('INSERT INTO tasks (id, title, prompt) VALUES (?, ?, ?)');
  
  const insertMany = db.transaction((tasks: Task[]) => {
    for (const task of tasks) {
      insertStmt.run(task.id, task.title, task.prompt);
    }
  });
  
  insertMany(tasks);
}
