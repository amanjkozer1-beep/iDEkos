  const limit = parseInt(req.query.limit as string) || 20;
  const offset = (page - 1) * limit;
  
  const tasks = await db.getTasksPaginated(limit, offset);
  const total = await db.getTasksCount();
  
  res.json({
    data: tasks,
    pagination: {
      page,
      limit,
      total,
      totalPages: Math.ceil(total / limit)
    }
  });
});

