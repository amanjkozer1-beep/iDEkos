class EnhancedAgentOrchestrator extends AgentOrchestrator {
  private contextManager: ContextManager;
  private selfCorrection: SelfCorrectionEngine;
  private rollbackManager: RollbackManager;
  private dependencyGraph: TaskDependencyGraph;
  
  constructor(rootPath?: string, providers?: any) {
    super(rootPath, providers);
    
    this.contextManager = new ContextManager(128000, 1000);
    this.selfCorrection = new SelfCorrectionEngine();
    this.rollbackManager = new RollbackManager(this.workspace);
    this.dependencyGraph = new TaskDependencyGraph();
  }
  
  private async executeRealAgentLoop(task: AgentTask) {
    const logMsg = (msg: string) => {
      task.logs.push(msg);
      this.storage.addLog(task.id, msg);
      this.emit('task:update', task);
    };
    
    logMsg(`[Enhanced Agent]: Initialized task execution`);
    
    // Create snapshot before execution
    const snapshotId = await this.rollbackManager.createSnapshot(task.id);
    logMsg(`[Snapshot]: Created ${snapshotId}`);
    
    task.status = 'running';
    
    const systemPrompt = `You are K.O.S Autonomous Agent...`;
    
    const contents: any[] = [
      { role: 'user', parts: [{ text: `Task Objective: ${task.prompt}` }] }
    ];
    
    let loopIteration = 0;
    const MAX_ITERATIONS = 6;
    
    while (loopIteration < MAX_ITERATIONS) {
      loopIteration++;
      logMsg(`[Iteration ${loopIteration}]: Calling model API`);
      
      // Truncate context if needed
      const truncatedContents = this.contextManager.truncateHistory(contents, systemPrompt);
      
      // Count tokens
      const tokenCount = this.contextManager.countHistory(truncatedContents);
      logMsg(`[Context]: ${tokenCount} tokens`);
      
      const modelResponse = await this.model.askModel(truncatedContents, systemPrompt, true);
      
      if (!modelResponse.isConfigured || modelResponse.error) {
        task.status = 'failed';
        logMsg(`Model error: ${modelResponse.error}`);
        
        // Rollback on failure
        await this.rollbackManager.restoreSnapshot(snapshotId);
        logMsg(`[Rollback]: Restored ${snapshotId}`);
        
        this.persistTask(task);
        this.emit('task:update', task);
        return;
      }
      
      const functionCalls = modelResponse.functionCalls;
      if (functionCalls && functionCalls.length > 0) {
        for (const call of functionCalls) {
          const { name, args } = call;
          logMsg(`[Tool Call]: ${name}`);
          
          // Execute with self-correction
          try {
            const result = await this.selfCorrection.executeWithSelfCorrection(
              name,
              args,
              { workspace: this.workspace, shell: this.shell }
            );
            
            // Handle success
            this.handleToolSuccess(name, args, result, contents, task, logMsg);
            
          } catch (error) {
            // Handle failure with retry
            logMsg(`[Tool Error]: ${error.message}`);
            
            if (loopIteration < MAX_ITERATIONS) {
              logMsg(`[Retry]: Will attempt alternative approach`);
              continue;
            }
            
            // Rollback if all retries failed
            await this.rollbackManager.restoreSnapshot(snapshotId);
            logMsg(`[Rollback]: Restored ${snapshotId}`);
            
            task.status = 'failed';
            this.persistTask(task);
            this.emit('task:update', task);
            return;
          }
        }
      } else {
        // No more function calls - task complete
        const finalStep: AgentStep = {
          id: `step-${Date.now()}-done`,
          title: 'Agent Task Completed',
          status: 'completed',
          timestamp: new Date().toLocaleTimeString(),
          details: modelResponse.text || 'Task completed successfully'
        };
        task.steps.push(finalStep);
        task.status = 'completed';
        logMsg('Task completed successfully');
        this.persistTask(task);
        this.emit('task:update', task);
        break;
      }
      
      this.persistTask(task);
      this.emit('task:update', task);
    }
    
    // Cleanup old snapshot
    this.rollbackManager.cleanupOldSnapshots();
  }
  
  private handleToolSuccess(
    toolName: string,
    args: any,
    result: any,
    contents: any[],
    task: AgentTask,
    logMsg: (msg: string) => void
